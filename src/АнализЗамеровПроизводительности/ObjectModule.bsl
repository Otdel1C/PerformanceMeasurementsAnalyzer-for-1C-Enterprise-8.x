#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();

	Если Метаданные.НайтиПоПолномуИмени("РегистрСведений.ЗамерыВремени") = Неопределено Тогда
		ВывестиСообщениеДиагностики(ДокументРезультат,
			НСтр("ru = 'Отчет недоступен: отсутствует регистр сведений ЗамерыВремени. Проверьте подсистему Оценка производительности БСП.'"));
		Возврат;
	КонецЕсли;

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	НастройкаПериода = Настройки.ПараметрыДанных.Элементы.Найти("Период");
	Если НастройкаПериода = Неопределено Тогда
		ВывестиСообщениеДиагностики(ДокументРезультат,
			НСтр("ru = 'Не найден параметр Период в настройках отчета. Восстановите стандартные настройки.'"));
		Возврат;
	КонецЕсли;

	ПериодОтчета = НастройкаПериода.Значение;
	Если ТипЗнч(ПериодОтчета) <> Тип("СтандартныйПериод") Тогда
		ВывестиСообщениеДиагностики(ДокументРезультат,
			НСтр("ru = 'Период отчета не задан. Выберите период и сформируйте отчет повторно.'"));
		Возврат;
	КонецЕсли;

	НачалоПериода = ПериодОтчета.ДатаНачала;
	КонецПериода = ПериодОтчета.ДатаОкончания;
	Если Не ЗначениеЗаполнено(НачалоПериода)
		Или Не ЗначениеЗаполнено(КонецПериода)
		Или НачалоПериода > КонецПериода Тогда
		ВывестиСообщениеДиагностики(ДокументРезультат,
			НСтр("ru = 'Указан некорректный период отчета. Проверьте даты начала и окончания.'"));
		Возврат;
	КонецЕсли;

	ИмяРегистраТехнологическихЗамеров = "РегистрСведений.ЗамерыВремениТехнологические";
	ЕстьРегистрТехнологическихЗамеров =
		Метаданные.НайтиПоПолномуИмени(ИмяРегистраТехнологическихЗамеров) <> Неопределено;

	ЕстьЗамеры = ЕстьЗамерыЗаПериод("РегистрСведений.ЗамерыВремени", НачалоПериода, КонецПериода);
	Если Не ЕстьЗамеры И ЕстьРегистрТехнологическихЗамеров Тогда
		ЕстьЗамеры = ЕстьЗамерыЗаПериод(ИмяРегистраТехнологическихЗамеров,
			НачалоПериода, КонецПериода);
	КонецЕсли;

	Если Не ЕстьЗамеры Тогда
		ВывестиСообщениеДиагностики(ДокументРезультат,
			НСтр("ru = 'За выбранный период замеры производительности не найдены. Проверьте период и настройку сбора замеров.'"));
		Возврат;
	КонецЕсли;

	СхемаКомпоновкиДанных = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	Если ЕстьРегистрТехнологическихЗамеров Тогда		
		ЗапросИсточника = СхемаКомпоновкиДанных.НаборыДанных.ЗамерыПроизводительности.Запрос;	
		СхемаЗапросаИсточника = Новый СхемаЗапроса;
		СхемаЗапросаИсточника.УстановитьТекстЗапроса(ЗапросИсточника);
		ОператорыЗапросаИсточника = СхемаЗапросаИсточника.ПакетЗапросов.Получить(0).Операторы;
		ИсточникТехнологическихЗамеров = ОператорыЗапросаИсточника.Добавить(ОператорыЗапросаИсточника.Получить(0));
		ИсточникТехнологическихЗамеров.ВыбираемыеПоля.Установить(17, Новый ВыражениеСхемыЗапроса("ИСТИНА"));
		ДоступныйИсточникТехнологическихЗамеров = СхемаЗапросаИсточника.ПакетЗапросов[0].ДоступныеТаблицы[7].Состав.Найти(ИмяРегистраТехнологическихЗамеров);
		ИсточникТехнологическихЗамеров.Источники.Заменить(0, ДоступныйИсточникТехнологическихЗамеров);
		СхемаКомпоновкиДанных.НаборыДанных.ЗамерыПроизводительности.Запрос = СхемаЗапросаИсточника.ПолучитьТекстЗапроса();
	КонецЕсли;
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;          
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;          
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	ЭлементРезультатКомпоновки = ПроцессорКомпоновкиДанных.Следующий();
	Если ЭлементРезультатКомпоновки = Неопределено Тогда
		ВывестиСообщениеДиагностики(ДокументРезультат,
			НСтр("ru = 'В выбранном периоде есть замеры, но отчет не вернул строк. Проверьте отборы и выбранный вариант отчета.'"));
		Возврат;
	КонецЕсли;

	ПроцессорВывода.НачатьВывод();
	Пока ЭлементРезультатКомпоновки <> Неопределено Цикл
		ПроцессорВывода.ВывестиЭлемент(ЭлементРезультатКомпоновки);
		ЭлементРезультатКомпоновки = ПроцессорКомпоновкиДанных.Следующий();
	КонецЦикла;
	ПроцессорВывода.ЗакончитьВывод();	
	
КонецПроцедуры

#КонецОбласти

#Область ДиагностикаГотовности

Функция ЕстьЗамерыЗаПериод(ИмяРегистра, НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|\tЗамеры.ДатаЗаписи КАК ДатаЗаписи
		|ИЗ
		|\t%1 КАК Замеры
		|ГДЕ
		|\tЗамеры.ДатаЗаписи МЕЖДУ &НачалоПериода И &КонецПериода", ИмяРегистра);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	РезультатЗапроса = Запрос.Выполнить();
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

Процедура ВывестиСообщениеДиагностики(ДокументРезультат, ТекстСообщения)

	ДокументРезультат.Очистить();
	ОбластьСообщения = ДокументРезультат.Область("R1C1");
	ОбластьСообщения.Текст = ТекстСообщения;
	Сообщить(ТекстСообщения, СтатусСообщения.Внимание);

КонецПроцедуры

#КонецОбласти