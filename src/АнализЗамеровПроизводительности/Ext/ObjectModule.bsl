#КонецОбласти

#Область НастройкиФормыОтчета

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	Настройки.События.ПриОпределенииПараметровВыбора = Истина;
	
	ПараметрыПерезагрузки = Новый Массив;
	ПараметрыПерезагрузки.Добавить(Новый ПараметрКомпоновкиДанных("Период"));
	ПараметрыПерезагрузки.Добавить(Новый ПараметрКомпоновкиДанных("ТолькоПользователиСЗамерами"));
	ПараметрыПерезагрузки.Добавить(Новый ПараметрКомпоновкиДанных("ПоказыватьНеактивныхПользователей"));
	Настройки.ЗагрузитьНастройкиПриИзмененииПараметров = ПараметрыПерезагрузки;
	
КонецПроцедуры

Процедура ПередЗагрузкойНастроекВКомпоновщик(
	Контекст,
	КлючСхемы,
	КлючВарианта,
	НовыеНастройкиКД,
	НовыеПользовательскиеНастройкиКД) Экспорт
	
	Если НовыеНастройкиКД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбораПользователь = НайтиЭлементОтбораПользователь(НовыеНастройкиКД);
	Если ЭлементОтбораПользователь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастроитьЭлементОтбораПользователь(ЭлементОтбораПользователь);
	
	Если ТипЗнч(НовыеПользовательскиеНастройкиКД) =
		Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		
		Для Каждого ЭлементПользовательскойНастройки Из
			НовыеПользовательскиеНастройкиКД.Элементы Цикл
			
			Если ТипЗнч(ЭлементПользовательскойНастройки) =
				Тип("ЭлементОтбораКомпоновкиДанных")
				И ЭлементПользовательскойНастройки.ИдентификаторПользовательскойНастройки =
					ЭлементОтбораПользователь.ИдентификаторПользовательскойНастройки Тогда
				
				НастроитьЭлементОтбораПользователь(ЭлементПользовательскойНастройки);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не ДоступенСписокПользователейИБ() Тогда
		ЭлементОтбораПользователь.Использование = Ложь;
		СообщитьОНедоступностиСпискаПользователей();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриОпределенииПараметровВыбора(Форма, СвойстваНастройки) Экспорт
	
	Если СвойстваНастройки.ДоступнаяНастройкаКД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Строка(СвойстваНастройки.ПолеКД) <> "Пользователь" Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваНастройки.ЗапросЗначенийВыбора.Текст = "";
	
	Если ТипЗнч(СвойстваНастройки.ЗначенияДляВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДоступенСписокПользователейИБ() Тогда
		СвойстваНастройки.ЗначенияДляВыбора.Очистить();
		СвойстваНастройки.ОграничиватьВыборУказаннымиЗначениями = Истина;
		СообщитьОНедоступностиСпискаПользователей();
		Возврат;
	КонецЕсли;
	
	ТолькоПользователиСЗамерами = ЗначениеБулевогоПараметраОтчета(
		Форма,
		"ТолькоПользователиСЗамерами",
		Ложь);
	
	ПоказыватьНеактивныхПользователей = ЗначениеБулевогоПараметраОтчета(
		Форма,
		"ПоказыватьНеактивныхПользователей",
		Истина);
	
	ИсторическиеЗначения = ПолучитьИсторическиеПредставленияПользователей(Форма);
	РезультатПолучения = ПолучитьТекущиеПредставленияПользователей(
		ИсторическиеЗначения,
		ТолькоПользователиСЗамерами,
		ПоказыватьНеактивныхПользователей);
	
	Если Не РезультатПолучения.Доступен Тогда
		СвойстваНастройки.ЗначенияДляВыбора.Очистить();
		СвойстваНастройки.ОграничиватьВыборУказаннымиЗначениями = Истина;
		СообщитьОНедоступностиСпискаПользователей();
		Возврат;
	КонецЕсли;
	
	СвойстваНастройки.ЗначенияДляВыбора.Очистить();
	ДобавленныеЗначения = Новый Соответствие;
	
	Для Каждого ЭлементСписка Из РезультатПолучения.Значения Цикл
		ДобавитьЗначениеВыбора(
			СвойстваНастройки.ЗначенияДляВыбора,
			ДобавленныеЗначения,
			ЭлементСписка.Значение,
			ЭлементСписка.Представление);
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из ИсторическиеЗначения Цикл
		КлючИсторическогоЗначения = Строка(ЭлементСписка.Значение);
		Если РезультатПолучения.СкрытыеЗначения.Получить(КлючИсторическогоЗначения) = Неопределено
			И ДобавленныеЗначения.Получить(КлючИсторическогоЗначения) = Неопределено Тогда
			ДобавитьЗначениеВыбора(
				СвойстваНастройки.ЗначенияДляВыбора,
				ДобавленныеЗначения,
				ЭлементСписка.Значение,
				НСтр("ru = '[Исторический] '") + ЭлементСписка.Представление);
		КонецЕсли;
	КонецЦикла;
	
	СвойстваНастройки.ОграничиватьВыборУказаннымиЗначениями = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеФункцииОтбораПользователей

Процедура НастроитьЭлементОтбораПользователь(ЭлементОтбораПользователь)
	
	ИсходноеПравоеЗначение = ЭлементОтбораПользователь.ПравоеЗначение;
	ЭлементОтбораПользователь.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбораПользователь.РежимОтображения =
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
	
	Если ТипЗнч(ИсходноеПравоеЗначение) <> Тип("СписокЗначений") Тогда
		ПравоеЗначение = Новый СписокЗначений;
		Если ЗначениеЗаполнено(ИсходноеПравоеЗначение) Тогда
			ПравоеЗначение.Добавить(ИсходноеПравоеЗначение);
		КонецЕсли;
		ЭлементОтбораПользователь.ПравоеЗначение = ПравоеЗначение;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(
		ЭлементОтбораПользователь.ИдентификаторПользовательскойНастройки) Тогда
		
		ЭлементОтбораПользователь.ИдентификаторПользовательскойНастройки =
			"ОтборПользователей";
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиЭлементОтбораПользователь(НастройкиКД)
	
	ПолеПользователь = Новый ПолеКомпоновкиДанных("Пользователь");
	
	Для Каждого ЭлементОтбора Из НастройкиКД.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = ПолеПользователь Тогда
			
			Возврат ЭлементОтбора;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗначениеБулевогоПараметраОтчета(
	Форма,
	ИмяПараметра,
	ЗначениеПоУмолчанию)
	
	ИтоговыеНастройки = Форма.Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыДанных = ИтоговыеНастройки.ПараметрыДанных;
	ЭлементНастройки = ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	
	Если ЭлементНастройки <> Неопределено
		И ТипЗнч(ЭлементНастройки.Значение) = Тип("Булево") Тогда
		
		Возврат ЭлементНастройки.Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция ДоступенСписокПользователейИБ()
	
	Попытка
		ПользователиИнформационнойБазы.ПолучитьПользователей();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура СообщитьОНедоступностиСпискаПользователей()
	
	Если ПредупреждениеОНедоступностиСпискаПользователейПоказано Тогда
		Возврат;
	КонецЕсли;
	
	ПредупреждениеОНедоступностиСпискаПользователейПоказано = Истина;
	Сообщить(
		НСтр("ru = 'Список пользователей недоступен. Отбор по пользователям отключён для текущего сеанса'"),
		СтатусСообщения.Внимание);
	
КонецПроцедуры

Процедура ДобавитьЗначениеВыбора(
	ЗначенияДляВыбора,
	ДобавленныеЗначения,
	Значение,
	Представление)
	
	КлючЗначения = Строка(Значение);
	Если ДобавленныеЗначения.Получить(КлючЗначения) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияДляВыбора.Добавить(Значение, Представление);
	ДобавленныеЗначения.Вставить(КлючЗначения, Истина);
	
КонецПроцедуры

Функция ПолучитьТекущиеПредставленияПользователей(
	ИсторическиеЗначения,
	ТолькоПользователиСЗамерами,
	ПоказыватьНеактивныхПользователей)
	
	Результат = Новый Структура;
	Результат.Вставить("Доступен", Истина);
	Результат.Вставить("Значения", Новый СписокЗначений);
	Результат.Вставить("СкрытыеЗначения", Новый Соответствие);
	Результат.Вставить("ТекстОшибки", "");
	
	Попытка
		ОписанияПользователейИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		Результат.Доступен = Ложь;
		Результат.ТекстОшибки =
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	ПользователиПриложения = ПолучитьПользователейПриложения(ОписанияПользователейИБ);
	ДобавленныеПредставления = Новый Соответствие;
	
	Для Каждого ОписаниеПользователяИБ Из ОписанияПользователейИБ Цикл
		ИмяПользователяИБ = СокрЛП(ОписаниеПользователяИБ.Имя);
		Если ПустаяСтрока(ИмяПользователяИБ) Тогда
			Продолжить;
		КонецЕсли;
		
		ПользовательПриложения = ПользователиПриложения.Получить(
			Строка(ОписаниеПользователяИБ.УникальныйИдентификатор));
		
		Если Не ПоказыватьНеактивныхПользователей
			И ПользовательДолженБытьСкрыт(
				ОписаниеПользователяИБ,
				ПользовательПриложения) Тогда
			
			ДобавитьСкрытыеПредставленияПользователя(
				Результат.СкрытыеЗначения,
				ИсторическиеЗначения,
				ИмяПользователяИБ,
				ПользовательПриложения);
			Продолжить;
		КонецЕсли;
		
		Если ПользовательПриложения <> Неопределено Тогда
			ПредставлениеПользователя =
				ИмяПользователяИБ + "; " + ПользовательПриложения.Наименование;
			
			Если Не ТолькоПользователиСЗамерами
				Или ИсторическиеЗначения.НайтиПоЗначению(
					ПредставлениеПользователя) <> Неопределено Тогда
				
				ДобавитьТекущееПредставлениеПользователя(
					Результат.Значения,
					ДобавленныеПредставления,
					ПредставлениеПользователя);
			КонецЕсли;
		Иначе
			ДобавленоИсторическоеПредставление = ДобавитьИсходныеПредставленияПользователя(
				Результат.Значения,
				ДобавленныеПредставления,
				ИсторическиеЗначения,
				ИмяПользователяИБ);
			
			Если Не ДобавленоИсторическоеПредставление
				И Не ТолькоПользователиСЗамерами Тогда
				
				ДобавитьТекущееПредставлениеПользователя(
					Результат.Значения,
					ДобавленныеПредставления,
					ИмяПользователяИБ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат.Значения.СортироватьПоПредставлению();
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСкрытыеПредставленияПользователя(
	СкрытыеЗначения,
	ИсторическиеЗначения,
	ИмяПользователяИБ,
	ПользовательПриложения)
	
	Если ПользовательПриложения <> Неопределено Тогда
		ТекущееПредставление = ИмяПользователяИБ + "; " + ПользовательПриложения.Наименование;
	Иначе
		ТекущееПредставление = ИмяПользователяИБ;
	КонецЕсли;
	СкрытыеЗначения.Вставить(ТекущееПредставление, Истина);
	
	ПрефиксПользователя = ИмяПользователяИБ + ";";
	Для Каждого ИсторическоеЗначение Из ИсторическиеЗначения Цикл
		ПредставлениеПользователя = Строка(ИсторическоеЗначение.Значение);
		Если ПредставлениеПользователя = ИмяПользователяИБ
			Или СтрНачинаетсяС(ПредставлениеПользователя, ПрефиксПользователя) Тогда
			СкрытыеЗначения.Вставить(ПредставлениеПользователя, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПользователейПриложения(ОписанияПользователейИБ)
	
	Результат = Новый Соответствие;
	Идентификаторы = Новый Массив;
	
	Для Каждого ОписаниеПользователяИБ Из ОписанияПользователейИБ Цикл
		Идентификаторы.Добавить(ОписаниеПользователяИБ.УникальныйИдентификатор);
	КонецЦикла;
	
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
	|	Пользователи.Наименование КАК Наименование,
	|	Пользователи.ПометкаУдаления КАК ПометкаУдаления,
	|	Пользователи.Недействителен КАК Недействителен,
	|	Пользователи.Служебный КАК Служебный
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ В (&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ОписаниеПользователя = Новый Структура;
			ОписаниеПользователя.Вставить("Наименование", Выборка.Наименование);
			ОписаниеПользователя.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
			ОписаниеПользователя.Вставить("Недействителен", Выборка.Недействителен);
			ОписаниеПользователя.Вставить("Служебный", Выборка.Служебный);
			Результат.Вставить(
				Строка(Выборка.ИдентификаторПользователяИБ),
				ОписаниеПользователя);
		КонецЦикла;
	Исключение
		// При отсутствии прав составное представление дополняется историческим значением,
		// а при его отсутствии используется имя пользователя информационной базы.
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПользовательДолженБытьСкрыт(
	ОписаниеПользователяИБ,
	ПользовательПриложения)
	
	ЕстьАутентификация =
		ОписаниеПользователяИБ.АутентификацияСтандартная
		Или ОписаниеПользователяИБ.АутентификацияОС
		Или ОписаниеПользователяИБ.АутентификацияOpenID
		Или ОписаниеПользователяИБ.АутентификацияOpenIDConnect
		Или ОписаниеПользователяИБ.АутентификацияТокеномДоступа;
	
	Если Не ЕстьАутентификация
		Или Не ОписаниеПользователяИБ.ПоказыватьВСпискеВыбора Тогда
		
		Возврат Истина;
	КонецЕсли;
	
	Если ПользовательПриложения <> Неопределено Тогда
		Возврат ПользовательПриложения.ПометкаУдаления
			Или ПользовательПриложения.Недействителен
			Или ПользовательПриложения.Служебный;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьТекущееПредставлениеПользователя(
	Значения,
	ДобавленныеПредставления,
	ПредставлениеПользователя)
	
	Если ДобавленныеПредставления.Получить(ПредставлениеПользователя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Значения.Добавить(ПредставлениеПользователя, ПредставлениеПользователя);
	ДобавленныеПредставления.Вставить(ПредставлениеПользователя, Истина);
	
КонецПроцедуры

Функция ДобавитьИсходныеПредставленияПользователя(
	Значения,
	ДобавленныеПредставления,
	ИсторическиеЗначения,
	ИмяПользователяИБ)
	
	Добавлено = Ложь;
	ПрефиксПользователя = ИмяПользователяИБ + ";";
	
	Для Каждого ИсторическоеЗначение Из ИсторическиеЗначения Цикл
		ПредставлениеПользователя = Строка(ИсторическоеЗначение.Значение);
		
		Если ПредставлениеПользователя = ИмяПользователяИБ
			Или СтрНачинаетсяС(ПредставлениеПользователя, ПрефиксПользователя) Тогда
			
			ДобавитьТекущееПредставлениеПользователя(
				Значения,
				ДобавленныеПредставления,
				ПредставлениеПользователя);
			
			Добавлено = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Добавлено;
	
КонецФункции

Функция ПолучитьИсторическиеПредставленияПользователей(Форма)
	
	Значения = Новый СписокЗначений;
	ГраницыПериода = ПолучитьГраницыПериодаОтчета(Форма);
	Если Не ГраницыПериода.Определены Тогда
		Возврат Значения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Замеры.Пользователь КАК Пользователь
		|ИЗ
		|	%1 КАК Замеры
		|ГДЕ
		|	Замеры.ДатаЗаписи МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Замеры.Пользователь <> """"
		|УПОРЯДОЧИТЬ ПО
		|	Пользователь",
		ИмяРегистраЗамеровВремени());
	
	Запрос.УстановитьПараметр("НачалоПериода", ГраницыПериода.Начало);
	Запрос.УстановитьПараметр("КонецПериода", ГраницыПериода.Конец);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПредставлениеПользователя = Строка(Выборка.Пользователь);
		Значения.Добавить(ПредставлениеПользователя, ПредставлениеПользователя);
	КонецЦикла;
	
	Возврат Значения;
	
КонецФункции

Функция ПолучитьГраницыПериодаОтчета(Форма)
	
	Результат = Новый Структура(
		"Определены, Начало, Конец",
		Ложь,
		Неопределено,
		Неопределено);
	
	ИтоговыеНастройки = Форма.Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыДанных = ИтоговыеНастройки.ПараметрыДанных;
	ПараметрПериод = ПараметрыДанных.Элементы.Найти("Период");
	
	Если ПараметрПериод = Неопределено
		Или Не ПараметрПериод.Использование Тогда
		
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат.Начало = ПараметрПериод.Значение.ДатаНачала;
		Результат.Конец = ПараметрПериод.Значение.ДатаОкончания;
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Результат.Определены =
		ЗначениеЗаполнено(Результат.Начало)
		И ЗначениеЗаполнено(Результат.Конец);
	
	Возврат Результат;
	
КонецФункции

Функция ИмяРегистраЗамеровВремени()
	
	ИмяРегистра = "РегистрСведений.ЗамерыВремени";
	ИмяРегистраТехнологическихЗамеров =
		"РегистрСведений.ЗамерыВремениТехнологические";
	
	Если Метаданные.НайтиПоПолномуИмени(
		ИмяРегистраТехнологическихЗамеров) <> Неопределено Тогда
		
		ИмяРегистра = ИмяРегистраТехнологическихЗамеров;
	КонецЕсли;
	
	Возврат ИмяРегистра;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(
	ДокументРезультат,
	ДанныеРасшифровки,
	СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СхемаКомпоновкиДанных = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	ИмяРегистраТехнологическихЗамеров =
		"РегистрСведений.ЗамерыВремениТехнологические";
	
	Если Метаданные.НайтиПоПолномуИмени(
		ИмяРегистраТехнологическихЗамеров) <> Неопределено Тогда
		
		ЗапросИсточника =
			СхемаКомпоновкиДанных.НаборыДанных.ЗамерыПроизводительности.Запрос;
		
		СхемаЗапросаИсточника = Новый СхемаЗапроса;
		СхемаЗапросаИсточника.УстановитьТекстЗапроса(ЗапросИсточника);
		
		ОператорыЗапросаИсточника =
			СхемаЗапросаИсточника.ПакетЗапросов.Получить(0).Операторы;
		
		ИсточникТехнологическихЗамеров =
			ОператорыЗапросаИсточника.Добавить(
				ОператорыЗапросаИсточника.Получить(0));
		
		ИсточникТехнологическихЗамеров.ВыбираемыеПоля.Установить(
			17,
			Новый ВыражениеСхемыЗапроса("ИСТИНА"));
		
		ДоступныйИсточникТехнологическихЗамеров =
			СхемаЗапросаИсточника.ПакетЗапросов[0].ДоступныеТаблицы[7].Состав.Найти(
				ИмяРегистраТехнологическихЗамеров);
		
		ИсточникТехнологическихЗамеров.Источники.Заменить(
			0,
			ДоступныйИсточникТехнологическихЗамеров);
		
		СхемаКомпоновкиДанных.НаборыДанных.ЗамерыПроизводительности.Запрос =
			СхемаЗапросаИсточника.ПолучитьТекстЗапроса();
	КонецЕсли;
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		СхемаКомпоновкиДанных,
		Настройки,
		ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(
		МакетКомпоновки,
		,
		ДанныеРасшифровки);
	
	ПроцессорВывода =
		Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.НачатьВывод();
	
	ЭлементРезультатКомпоновки = ПроцессорКомпоновкиДанных.Следующий();
	Пока ЭлементРезультатКомпоновки <> Неопределено Цикл
		ПроцессорВывода.ВывестиЭлемент(ЭлементРезультатКомпоновки);
		ЭлементРезультатКомпоновки = ПроцессорКомпоновкиДанных.Следующий();
	КонецЦикла;
	
	ПроцессорВывода.ЗакончитьВывод();
	
КонецПроцедуры

#КонецОбласти